<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x650">
    <pose>0 0 0.31 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Base mass includes the 55 g STS3215 housing fixed to the airframe. -->
    <link name="base_link">
      <inertial>
        <mass>3.191</mass>
        <inertia>
          <ixx>0.118</ixx><iyy>0.118</iyy><izz>0.218</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="center_collision">
        <geometry><box><size>0.18 0.18 0.075</size></box></geometry>
      </collision>
      <visual name="lower_plate">
        <pose>0 0 -0.018 0 0 0</pose>
        <geometry><box><size>0.16 0.16 0.008</size></box></geometry>
        <material><diffuse>0.025 0.025 0.025 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
      <visual name="upper_plate">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry><box><size>0.16 0.16 0.008</size></box></geometry>
        <material><diffuse>0.025 0.025 0.025 1</diffuse></material>
      </visual>
      <visual name="battery">
        <pose>-0.025 0 0.075 0 0 0</pose>
        <geometry><box><size>0.19 0.075 0.06</size></box></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="pixhawk">
        <pose>0.035 0 0.075 0 0 0</pose>
        <geometry><box><size>0.075 0.05 0.025</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="front_camera_body">
        <pose>0.11 0 0.02 0 0 0</pose>
        <geometry><box><size>0.04 0.05 0.03</size></box></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="front_camera_lens">
        <pose>0.135 0 0.02 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.03 0.08 0.16 1</diffuse><specular>0.5 0.5 0.6 1</specular></material>
      </visual>

      <!-- STS3215 housing: 15 cm forward (+X), 10 cm below (-Z). -->
      <visual name="manipulator_servo">
        <pose>0.15 0 -0.10 0 0 0</pose>
        <geometry><box><size>0.0452 0.0247 0.035</size></box></geometry>
        <material><diffuse>0.12 0.18 0.24 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <collision name="manipulator_servo_collision">
        <pose>0.15 0 -0.10 0 0 0</pose>
        <geometry><box><size>0.0452 0.0247 0.035</size></box></geometry>
      </collision>

      <!-- Four 20 mm carbon tubes; centers are halfway to each motor. -->
      <visual name="arm_fr"><pose>0.114905 -0.114905 0 0 1.570796 -0.785398</pose><geometry><cylinder><radius>0.01</radius><length>0.325</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
      <visual name="arm_rl"><pose>-0.114905 0.114905 0 0 1.570796 -0.785398</pose><geometry><cylinder><radius>0.01</radius><length>0.325</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
      <visual name="arm_fl"><pose>0.114905 0.114905 0 0 1.570796 0.785398</pose><geometry><cylinder><radius>0.01</radius><length>0.325</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
      <visual name="arm_rr"><pose>-0.114905 -0.114905 0 0 1.570796 0.785398</pose><geometry><cylinder><radius>0.01</radius><length>0.325</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>

      <visual name="leg_left"><pose>0 0.135 -0.145 0 0 0</pose><geometry><box><size>0.31 0.016 0.016</size></box></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <visual name="leg_right"><pose>0 -0.135 -0.145 0 0 0</pose><geometry><box><size>0.31 0.016 0.016</size></box></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <collision name="leg_left_collision"><pose>0 0.135 -0.145 0 0 0</pose><geometry><box><size>0.31 0.016 0.016</size></box></geometry></collision>
      <collision name="leg_right_collision"><pose>0 -0.135 -0.145 0 0 0</pose><geometry><box><size>0.31 0.016 0.016</size></box></geometry></collision>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>50</update_rate>
        <air_pressure><pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure></air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>3e-7</stddev></noise></x>
          <y><noise type="gaussian"><stddev>3e-7</stddev></noise></y>
          <z><noise type="gaussian"><stddev>3e-7</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.00087</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.00087</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.00087</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.0064</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0064</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0069</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>20</update_rate>
      </sensor>
      <!-- Fixed forward-facing RGB camera. Gazebo cameras look along +X. -->
      <sensor name="front_camera" type="camera">
        <pose>0.14 0 0.02 0 0 0</pose>
        <topic>/x650/camera/gz_image</topic>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.57079632679</horizontal_fov>
          <image>
            <width>640</width><height>480</height><format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- 50 cm arm with a 0.5 kg payload at its midpoint. The Y-axis joint
         produces a forward/back tilt in the vehicle X-Z plane. -->
    <link name="manipulator_link">
      <pose relative_to="base_link">0.15 0 -0.35 0 0 0</pose>
      <inertial>
        <!-- 0.1 kg arm + 0.5 kg centered payload. -->
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00262</ixx><iyy>0.00262</iyy><izz>0.00054</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="arm">
        <geometry><box><size>0.018 0.018 0.5</size></box></geometry>
        <material><diffuse>0.85 0.45 0.08 1</diffuse></material>
      </visual>
      <collision name="arm_collision">
        <geometry><box><size>0.018 0.018 0.5</size></box></geometry>
      </collision>
      <visual name="midpoint_payload">
        <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
        <material><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <collision name="midpoint_payload_collision">
        <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
      </collision>
    </link>
    <joint name="manipulator_tilt_joint" type="revolute">
      <pose relative_to="base_link">0.15 0 -0.10 0 0 0</pose>
      <parent>base_link</parent>
      <child>manipulator_link</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
        <limit>
          <lower>-3.141593</lower><upper>1.570796</upper>
          <!-- ST-3215-C018: 30 kg.cm stall torque and 0.222 s/60 deg at 12 V. -->
          <effort>2.942</effort><velocity>4.72</velocity>
        </limit>
        <dynamics><damping>0.08</damping><friction>0.03</friction></dynamics>
      </axis>
    </joint>

    <!-- Rotor order matches PX4's gz_x500 Quad-X mapping. Opposing pairs spin alike. -->
    <link name="rotor_0">
      <pose>0.22981 -0.22981 0.035 0 0 0</pose><gravity>true</gravity>
      <inertial><mass>0.016</mass><inertia><ixx>4e-7</ixx><iyy>0.00015</iyy><izz>0.00015</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.025 0 0 0</pose><geometry><cylinder><radius>0.027</radius><length>0.05</length></cylinder></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="prop"><geometry><box><size>0.381 0.025 0.004</size></box></geometry><material><diffuse>0.12 0.12 0.12 0.75</diffuse></material></visual>
      <collision name="prop_collision"><geometry><box><size>0.381 0.025 0.004</size></box></geometry></collision>
    </link>
    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

    <link name="rotor_1">
      <pose>-0.22981 0.22981 0.035 0 0 0</pose><gravity>true</gravity>
      <inertial><mass>0.016</mass><inertia><ixx>4e-7</ixx><iyy>0.00015</iyy><izz>0.00015</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.025 0 0 0</pose><geometry><cylinder><radius>0.027</radius><length>0.05</length></cylinder></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="prop"><geometry><box><size>0.381 0.025 0.004</size></box></geometry><material><diffuse>0.12 0.12 0.12 0.75</diffuse></material></visual>
      <collision name="prop_collision"><geometry><box><size>0.381 0.025 0.004</size></box></geometry></collision>
    </link>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

    <link name="rotor_2">
      <pose>0.22981 0.22981 0.035 0 0 0</pose><gravity>true</gravity>
      <inertial><mass>0.016</mass><inertia><ixx>4e-7</ixx><iyy>0.00015</iyy><izz>0.00015</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.025 0 0 0</pose><geometry><cylinder><radius>0.027</radius><length>0.05</length></cylinder></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="prop"><geometry><box><size>0.381 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.12 0.05 0.8</diffuse></material></visual>
      <collision name="prop_collision"><geometry><box><size>0.381 0.025 0.004</size></box></geometry></collision>
    </link>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

    <link name="rotor_3">
      <pose>-0.22981 -0.22981 0.035 0 0 0</pose><gravity>true</gravity>
      <inertial><mass>0.016</mass><inertia><ixx>4e-7</ixx><iyy>0.00015</iyy><izz>0.00015</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.025 0 0 0</pose><geometry><cylinder><radius>0.027</radius><length>0.05</length></cylinder></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="prop"><geometry><box><size>0.381 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.12 0.05 0.8</diffuse></material></visual>
      <collision name="prop_collision"><geometry><box><size>0.381 0.025 0.004</size></box></geometry></collision>
    </link>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

    <!-- 2.15e-5 gives about 31 N total thrust near 600 rad/s. -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>850</maxRotVelocity><motorConstant>2.15e-05</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>0</motorNumber><rotorDragCoefficient>1.1e-04</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>850</maxRotVelocity><motorConstant>2.15e-05</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>1</motorNumber><rotorDragCoefficient>1.1e-04</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>850</maxRotVelocity><motorConstant>2.15e-05</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>2</motorNumber><rotorDragCoefficient>1.1e-04</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>850</maxRotVelocity><motorConstant>2.15e-05</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>3</motorNumber><rotorDragCoefficient>1.1e-04</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>manipulator_tilt_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>manipulator_tilt_joint</joint_name>
      <update_rate>250</update_rate>
    </plugin>
  </model>
</sdf>

